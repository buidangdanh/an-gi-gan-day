# Sao chép thành .env.local ở gốc repo. Không commit secrets.
DATABASE_URL=postgresql://angiday:local_demo_only@127.0.0.1:55439/angiday
# Tùy chọn: trỏ tới Read Replica (qua PgBouncer) ở production chịu tải lớn
DATABASE_READ_URL=
DB_POOL_MAX=20
DB_READ_POOL_MAX=40
WEB_ORIGIN=http://127.0.0.1:3100
WEB_EXTRA_ORIGINS=https://timquanngon.com,https://www.timquanngon.com
API_PORT=4100
API_INTERNAL_URL=http://127.0.0.1:4100
# Đặt true khi chạy phía sau Cloudflare / Reverse Proxy tin cậy
TRUST_PROXY=false
# Đặt true ở production để chỉ phục vụ dữ liệu có bản quyền hợp lệ
STRICT_LICENSE_MODE=false
# Chỉ bật development. Production từ chối khởi động nếu bật.
ENABLE_DEV_AUTH=true
# Tạo giá trị ngẫu nhiên >=32 ký tự khi chạy production.
ADMIN_TOKEN=
AUTH_TOKEN_PEPPER=

# --- Đăng nhập Mạng xã hội 1 chạm (0đ) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Gửi Email Xác thực & Quên mật khẩu miễn phí (Resend chính + Brevo dự phòng) ---
EMAIL_FROM="Tìm quán ngon <no-reply@timquanngon.com>"
RESEND_API_KEY=
BREVO_API_KEY=

# --- Chống Bot / DDoS cho khu vực Tài khoản (Cloudflare Turnstile 0đ) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Xác thực Số điện thoại đảo chiều miễn phí 0đ qua Telegram Bot ---
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Các tích hợp tùy chọn khác ---
FIREBASE_PROJECT_ID=
GOOGLE_MAPS_GEOCODING_API_KEY=
PAYMENT_WEBHOOK_SECRET=
