ENABLE_DEV_AUTH=true
# Tạo giá trị ngẫu nhiên >=32 ký tự khi chạy production.
ADMIN_TOKEN=
GOOGLE_CLIENT_ID=
FIREBASE_PROJECT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_MAPS_GEOCODING_API_KEY=
