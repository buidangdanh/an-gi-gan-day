{
  "name": "an-gi-gan-day",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "preview:phone": "node scripts/phone-preview.mjs",
    "dev:api": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3100",
    "build": "npm run build:api && next build apps/web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db.ts seed",
    "data:import:hanoi": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/import-hanoi.ts",
    "data:geocode:hanoi": "node scripts/geocode-hanoi.mjs",
    "data:activate:hanoi": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/activate-hanoi.ts",
    "test": "npm run build:api && node --env-file-if-exists=.env.local --test --test-concurrency=1 apps/api/dist/test/*.test.js",
    "admin": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/admin.ts",
    "start:api": "node --env-file-if-exists=.env.local apps/api/dist/src/main.js",
    "start:web": "next start apps/web --hostname 127.0.0.1 --port 3100",
    "data:import:foody": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/import-foody.ts",
    "data:sync:images": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/sync-foody-images.ts",
    "data:sync:remaining": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/sync-foody-remaining-and-saves.ts",
    "data:sync:cities": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/sync-major-cities.ts",
    "check:foody": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/check-foody-catalogue.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
